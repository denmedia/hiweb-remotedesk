<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «ПК» — та же карточка, что в списке ПК (ui/Components.kt, DeviceCard): строка состояния со значками «Файлы» и щитом,
     превью, название и адрес с «Поделиться», «Подключиться»/«Настройки» и кнопки питания. Сгенерирована скриптом, кнопки
     одинаковые: id <кнопка>, <кнопка>_icon, <кнопка>_label. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="#FF6B7A99" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/widget_pc_checking"
                android:textColor="#FF8D9BB8"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/widget_os"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_windows"
                android:tint="#FF1F6BF2" />

            <TextView
                android:id="@+id/widget_os_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:text="Windows"
                android:textColor="#FF8D9BB8"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/widget_files"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Файлы ПК"
                android:padding="6dp"
                android:src="@drawable/ic_widget_folder"
                android:tint="#FF8D9BB8" />

            <FrameLayout
                android:id="@+id/widget_guard"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:contentDescription="Защита подключений">

                <ImageView
                    android:id="@+id/widget_guard_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/ic_widget_shield"
                    android:tint="#FF8D9BB8" />

                <TextView
                    android:id="@+id/widget_guard_count"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/widget_badge_bg"
                    android:gravity="center"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/widget_pick"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@string/widget_pc_pick"
                android:padding="6dp"
                android:src="@drawable/ic_widget_swap"
                android:tint="#FF8D9BB8" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_preview_bg"
                android:clipToOutline="true"
                android:contentDescription="@string/widget_pc_connect"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:id="@+id/widget_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_overlay_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:alpha="0.8"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_offline" />

                <TextView
                    android:id="@+id/widget_overlay_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="#D9FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_overlay_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#A6FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/widget_pc_sample_name"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/widget_pc_sample_host"
                    android:textColor="#FF8D9BB8"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_share"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Поделиться ПК"
                android:padding="9dp"
                android:src="@drawable/ic_widget_share"
                android:tint="#FF8D9BB8" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_btn_connect"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="2"
                android:background="@drawable/widget_btn_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/widget_btn_connect_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_desktop"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/widget_btn_connect_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Подключиться"
                    android:textColor="#FF8D9BB8"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_btn_settings"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/widget_btn_settings_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_settings"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/widget_btn_settings_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Настройки"
                    android:textColor="#FF8D9BB8"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_power_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_pw0"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/widget_pw0_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_power"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/widget_pw0_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Выключить"
                    android:textColor="#FF8D9BB8"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_pw1"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/widget_pw1_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_restart"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/widget_pw1_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Перезагрузка"
                    android:textColor="#FF8D9BB8"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_pw2"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/widget_pw2_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_sleep"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/widget_pw2_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Сон"
                    android:textColor="#FF8D9BB8"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_pw3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/widget_pw3_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_hibernate"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/widget_pw3_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Гибернация"
                    android:textColor="#FF8D9BB8"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_pw4"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/widget_pw4_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_logout"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/widget_pw4_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Выйти"
                    android:textColor="#FF8D9BB8"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ПК не выбран или удалён из приложения -->
    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_root_pc"
            android:tint="#FF8D9BB8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/widget_pc_empty"
            android:textColor="#FF8D9BB8"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
